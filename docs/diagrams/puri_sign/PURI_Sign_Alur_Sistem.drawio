  <diagram id="puri-2" name="02 Provisioning">
    <mxGraphModel dx="1200" dy="1460" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1460" math="0" shadow="0">
      <root>
