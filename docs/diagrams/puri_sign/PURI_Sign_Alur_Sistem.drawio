  <diagram id="puri-4" name="04 Engine bersama">
    <mxGraphModel dx="1200" dy="1440" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1440" math="0" shadow="0">
