          <mxGeometry as="geometry" x="529" y="493" width="141" height="30" />
        </mxCell>
        <mxCell id="mux" value="Pemilih operand / start dan pemilah done / error&#10;provision_owner atau sign_owner berasal dari FSM&#10;Respons selesai/error hanya diteruskan kepada owner aktif" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
