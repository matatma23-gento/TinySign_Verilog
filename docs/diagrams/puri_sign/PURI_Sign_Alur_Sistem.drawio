        </mxCell>
        <mxCell id="prov" value="CMD_PROVISION = 1&#10;Validasi key → hitung public key Q = dG" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#EAF2FC;strokeColor=#3973A8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="361" width="440" height="86" />
        </mxCell>
        <mxCell id="lock" value="CMD_LOCK = 2&#10;key_valid = 1 → key_locked = 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="487" width="440" height="78" />
        </mxCell>
        <mxCell id="doc" value="HOST&#10;Hash dokumen → digest SHA-256 256 bit" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="605" width="440" height="78" />
        </mxCell>
