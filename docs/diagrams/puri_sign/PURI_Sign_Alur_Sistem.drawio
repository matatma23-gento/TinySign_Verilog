        <mxCell id="begin" value="Reset / awal penggunaan" style="ellipse;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
