        <mxCell id="fsm" value="tinysign_core: FSM perintah&#10;IDLE → PROVISION_WAIT / LOCK_WAIT / SIGN_WAIT / ZEROIZE_WAIT" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#EAF2FC;strokeColor=#3973A8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="170" y="300" width="860" height="95" />
        </mxCell>
