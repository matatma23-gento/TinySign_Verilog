        </mxCell>
        <mxCell id="scalar" value="1 × scalar_mult&#10;dG atau kG&#10;point_ops internal" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#EAF2FC;strokeColor=#3973A8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="970" width="330" height="125" />
