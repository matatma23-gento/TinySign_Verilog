          <mxGeometry as="geometry" x="100" y="723" width="440" height="78" />
        </mxCell>
        <mxCell id="sign" value="CMD_SIGN = 4&#10;Core memeriksa key_valid dan key_locked" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="841" width="440" height="86" />
        </mxCell>
