        <mxCell id="title" value="Provisioning | Validasi, public key, dan lock" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=28;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="25" width="1110" height="44" />
        </mxCell>
        <mxCell id="subtitle" value="Owner engine = PROVISION. Private key tidak tersedia pada jalur pembacaan register." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
