        <mxCell id="inv" value="1 × mod_inv&#10;Z⁻¹ mod p atau k⁻¹ mod n&#10;Aritmetika internal sendiri" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="970" width="330" height="125" />
        </mxCell>
        <mxCell id="mul" value="1 × mod_mul di level core&#10;Konversi affine dan&#10;perkalian ECDSA" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
