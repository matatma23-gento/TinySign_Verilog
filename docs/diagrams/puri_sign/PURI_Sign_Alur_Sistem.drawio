  <diagram id="puri-3" name="03 Signing ECDSA">
    <mxGraphModel dx="1200" dy="1770" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1770" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Signing | Dari digest menjadi signature (r, s)" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=28;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="25" width="1110" height="44" />
        </mxCell>
        <mxCell id="subtitle" value="Owner engine = SIGN. p adalah modulus field; n adalah orde subgroup; seluruh operand utama 256 bit." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="77" width="1110" height="48" />
        </mxCell>
        <mxCell id="footer" value="PURI-Sign | Berdasarkan RTL shared-engine, 8 Oktober 2026 | Diagram alur, bukan timing fisik" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=13;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1725" width="1110" height="28" />
        </mxCell>
        <mxCell id="start" value="HOST: tulis digest, lalu CMD_SIGN" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="145" width="500" height="65" />
        </mxCell>
        <mxCell id="check" value="key_valid = 1 dan key_locked = 1?" style="rhombus;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=15;fontColor=#243746;fillColor=#FFF4DC;strokeColor=#B68125;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="255" width="500" height="110" />
        </mxCell>
        <mxCell id="latch" value="Signer menyalin private key d&#10;Validasi 1 ≤ d &lt; n; z = digest mod n" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="415" width="500" height="80" />
        </mxCell>
        <mxCell id="nonce" value="RFC6979 → HMAC-SHA-256&#10;Bentuk nonce deterministik k dari d dan z" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="535" width="500" height="85" />
        </mxCell>
        <mxCell id="scalar" value="SHARED SCALAR&#10;R = kG → (X, Y, Z) Jacobian" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#EAF2FC;strokeColor=#3973A8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="660" width="500" height="80" />
        </mxCell>
        <mxCell id="affine" value="SHARED INVERSE + MULTIPLY&#10;u = Z⁻¹ mod p; x = X·u² mod p&#10;r = x mod n" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="780" width="500" height="100" />
        </mxCell>
        <mxCell id="rcheck" value="r ≠ 0?" style="rhombus;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FFF4DC;strokeColor=#B68125;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="925" width="500" height="105" />
        </mxCell>
        <mxCell id="kinv" value="SHARED INVERSE&#10;v = k⁻¹ mod n" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="1075" width="500" height="75" />
        </mxCell>
        <mxCell id="math" value="SHARED MULTIPLY + mod_add lokal&#10;t = (z + r·d) mod n&#10;s = v·t mod n" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="85" y="1190" width="500" height="95" />
        </mxCell>
        <mxCell id="scheck" value="s ≠ 0?" style="rhombus;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FFF4DC;strokeColor=#B68125;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
