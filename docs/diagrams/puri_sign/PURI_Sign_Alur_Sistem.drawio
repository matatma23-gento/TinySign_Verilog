  <diagram id="puri-5" name="05 Zeroize dan error">
    <mxGraphModel dx="1200" dy="1490" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="1490" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Kontrol | ZEROIZE, status, dan penolakan akses" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=28;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="25" width="1110" height="44" />
        </mxCell>
        <mxCell id="subtitle" value="ZEROIZE adalah pengecualian saat busy; perintah harus ditulis dengan byte_enable = 0xF." style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="77" width="1110" height="48" />
        </mxCell>
        <mxCell id="footer" value="PURI-Sign | Berdasarkan RTL shared-engine, 8 Oktober 2026 | Diagram alur, bukan timing fisik" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=13;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1445" width="1110" height="28" />
        </mxCell>
        <mxCell id="command" value="HOST: CMD_ZEROIZE = 5&#10;Dapat dikirim saat idle maupun operasi aktif" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FCEDED;strokeColor=#B65050;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="150" width="520" height="85" />
        </mxCell>
        <mxCell id="abort" value="Core memicu key_zeroize&#10;Pindah ke ZEROIZE_WAIT → owner dilepas&#10;Hapus digest dan r/s core; sign_valid = 0" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FCEDED;strokeColor=#B65050;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="290" width="520" height="100" />
        </mxCell>
        <mxCell id="eng" value="Reset shared scalar / inverse / multiply&#10;Clear signer dan RFC6979&#10;Batalkan pekerjaan yang sedang berlangsung" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FCEDED;strokeColor=#B65050;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="445" width="520" height="100" />
        </mxCell>
        <mxCell id="key" value="key_manager membersihkan staging, key,&#10;public key dan state sementara&#10;key_valid = 0; key_locked = 0; key_done = 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FCEDED;strokeColor=#B65050;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="600" width="520" height="100" />
        </mxCell>
        <mxCell id="idle" value="Core menerima key_done&#10;done_latch = 1; busy = 0; zeroized = 1&#10;Kembali IDLE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="755" width="520" height="100" />
        </mxCell>
        <mxCell id="again" value="Host dapat melakukan provisioning baru" style="ellipse;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="910" width="520" height="65" />
        </mxCell>
        <mxCell id="writes" value="BUS WRITE SAAT BUSY&#10;Selain CMD_ZEROIZE → error_code 0x03.&#10;Operasi aktif tetap berjalan;&#10;penolakan write tidak membatalkannya." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FFF4DC;strokeColor=#B68125;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="165" width="410" height="120" />
        </mxCell>
        <mxCell id="byte" value="BYTE ENABLE / ALAMAT&#10;Write harus satu word penuh (0xF).&#10;Byte enable salah / alamat tidak didukung&#10;→ error_code 0x04." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FFF4DC;strokeColor=#B68125;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="335" width="410" height="120" />
        </mxCell>
        <mxCell id="errors" value="ERROR PERINTAH / OPERASI&#10;0x01: command / prasyarat key tidak valid&#10;0x02: key_manager atau signer gagal&#10;Status error harus diperiksa host." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FFF4DC;strokeColor=#B68125;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="505" width="410" height="120" />
        </mxCell>
        <mxCell id="clear" value="CMD_CLEAR_STATUS = 6 (saat idle)&#10;Hapus done/error/error_code, sign_valid,&#10;dan zeroized. Tidak menghapus key&#10;atau isi register signature r/s." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="675" width="410" height="120" />
        </mxCell>
        <mxCell id="status" value="REGISTER STATUS&#10;ready, busy, done, error, key_valid,&#10;key_locked, sign_valid, zeroized&#10;Readback key selalu bernilai 0." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="720" y="845" width="410" height="120" />
        </mxCell>
        <mxCell id="timing" value="URUTAN PADA TRACE RTL @ 25 MHz&#10;T0: perintah diterima, key_zeroize aktif, shared engine berhenti dan sign_valid core turun.&#10;T0 + 1 siklus: key_valid dan key_locked turun.&#10;T0 + 2 siklus: core menyelesaikan ZEROIZE dan kembali idle." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#EAF2FC;strokeColor=#3973A8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1060" width="1060" height="135" />
        </mxCell>
        <mxCell id="scope" value="BATAS DIAGRAM&#10;Ini alur perilaku RTL yang tersedia, bukan klaim sertifikasi secure element atau ketahanan serangan fisik.&#10;Reset/clear logika tidak membuktikan waktu penghapusan fisik. Latensi di atas berasal dari simulasi.&#10;Integrasi clock 25 MHz, pin board, dan host tetap mengikuti batas implementasi proyek." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="1240" width="1060" height="135" />
        </mxCell>
