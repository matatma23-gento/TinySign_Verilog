        </mxCell>
        <mxCell id="valid" value="Key belum valid, 8 word lengkap,&#10;dan 1 ≤ d &lt; n?" style="rhombus;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=15;fontColor=#243746;fillColor=#FFF4DC;strokeColor=#B68125;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="275" width="440" height="120" />
        </mxCell>
        <mxCell id="scalar" value="SHARED SCALAR&#10;Hitung Q = dG → koordinat Jacobian (X,Y,Z)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#EAF2FC;strokeColor=#3973A8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="450" width="440" height="86" />
        </mxCell>
        <mxCell id="inv" value="SHARED INVERSE&#10;u = Z⁻¹ mod p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="580" width="440" height="78" />
        </mxCell>
        <mxCell id="mul" value="SHARED MULTIPLY, dipakai berurutan&#10;u² → u³ → Qx = X·u² → Qy = Y·u³&#10;Semua operasi modulo p" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F0EBFA;strokeColor=#8260A7;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="700" width="440" height="105" />
        </mxCell>
        <mxCell id="commit" value="Simpan d pada key_reg; simpan Qx dan Qy&#10;key_valid = 1; bersihkan staging / sementara&#10;Core: done = 1, kembali IDLE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="850" width="440" height="105" />
        </mxCell>
        <mxCell id="lock" value="HOST: CMD_LOCK&#10;Key valid → key_locked = 1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1000" width="440" height="78" />
        </mxCell>
        <mxCell id="ready" value="Kunci siap dipakai signing&#10;Readback private key tetap 0" style="ellipse;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="100" y="1125" width="440" height="78" />
        </mxCell>
        <mxCell id="yes" value="Ya" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=15;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="290" y="405" width="60" height="28" />
        </mxCell>
        <mxCell id="invalid" value="Tolak provisioning&#10;key_error → core error_code = 0x02&#10;Tidak meneruskan perhitungan public key" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FCEDED;strokeColor=#B65050;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="285" width="420" height="100" />
        </mxCell>
        <mxCell id="no" value="Tidak" style="text;strokeColor=none;fillColor=none;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=15;fontColor=#243746;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="580" y="305" width="100" height="28" />
        </mxCell>
        <mxCell id="error" value="Jika salah satu engine mengirim error:&#10;hentikan urutan controller → IDLE&#10;Core melaporkan error_code = 0x02&#10;Host memeriksa error sebelum lanjut." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FCEDED;strokeColor=#B65050;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="595" width="420" height="125" />
        </mxCell>
        <mxCell id="policy" value="ATURAN KEY&#10;Penulisan key ditolak jika key_valid&#10;atau key_locked sudah aktif.&#10;LOCK memerlukan key yang valid.&#10;Penggantian key dimulai dengan ZEROIZE." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="850" width="420" height="150" />
        </mxCell>
        <mxCell id="symbols" value="NOTASI&#10;p: modulus field P-256&#10;n: orde subgroup P-256&#10;G: base point; d: private key" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
