        </mxCell>
        <mxCell id="q" value="Public key Q = (Qx, Qy) dapat dibaca&#10;CMD_GET_PUB = 3 memeriksa key_valid&#10;Detail provisioning: halaman 02" style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#EAF2FC;strokeColor=#3973A8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="355" width="450" height="110" />
        </mxCell>
        <mxCell id="hostnote" value="BATAS HOST / CORE&#10;Core menerima digest, bukan file dokumen.&#10;SHA-256 di jalur nonce dipakai HMAC.&#10;Private key berasal dari provisioning host;&#10;tidak ada generator key acak pada alur ini." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#F2F5F8;strokeColor=#7C8C9B;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="600" width="450" height="155" />
        </mxCell>
        <mxCell id="timing" value="LATENSI SIMULASI @ 25 MHz&#10;Provisioning: 292,14824 ms&#10;Signing: 297,51360 ms&#10;Tidak termasuk transfer input/output host." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#FFF4DC;strokeColor=#B68125;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="835" width="450" height="125" />
        </mxCell>
        <mxCell id="repeat" value="TRANSAKSI BERIKUTNYA&#10;Kunci tetap tersimpan dan terkunci.&#10;Host menulis digest baru, lalu CMD_SIGN.&#10;Untuk mengganti kunci: ZEROIZE dahulu." style="rounded=1;arcSize=12;whiteSpace=wrap;html=0;fontFamily=DejaVu Sans;fontSize=16;fontColor=#243746;fillColor=#E8F5EF;strokeColor=#25816C;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
